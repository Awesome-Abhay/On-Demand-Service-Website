<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Contact Us</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="/style.css">
    <link rel="stylesheet" href="/utility.css">
    <link rel="stylesheet" href="/navStyle.css">
    <link rel="stylesheet" href="/contactStyle.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css">
    <script src="/update.js" defer type="module"></script>
</head>
<body>

    <%- include('includes/dialog.ejs') %>

    <%- include("includes/nav.ejs") %>

    <div class="aboutOuter flex align-center">
        <div class="aboutInner">
            <div>Home | Contact</div>
            <div>Contact Us</div>
        </div>
    </div>

    <div class="mainItems">
        <div class="card">
            <div style="background-color: #ff6b2c;">
                <img src="/svgs/call.svg">
            </div>
            <div>Call Us</div>
            <div class="num">412-743-5679</div>
            <div class="num">412-743-5679</div>
        </div>
        <div class="card">
            <div style="background-color: #1dbf73;">
                <img src="/svgs/mail.svg">
            </div>
            <div>Mail Address</div>
            <div class="num">contact@mail.com</div>
            <div class="num">support@mail.com</div>
        </div>
        <div class="card">
            <div style="background-color: #47c8ed;">
                <img src="/svgs/support.svg">
            </div>
            <div>Support Time</div>
            <div class="num">08:00am to 11:00pm</div>
            <div class="num">Monday to Friday</div>
        </div>
    </div>

    <section class="touch">
        <div>Get In Touch</div>
        <hr class="black">

        <form>
            <div>
                <div class="card">
                    <label for="name">Your Name</label>
                    <input type="text" id="name" placeholder="Type Name">
                </div>
                <div class="card">
                    <label for="mail">Email Address</label>
                    <input type="text" id="mail" placeholder="Type Email">
                </div>
                <div class="card">
                    <label for="num">Phone Number</label>
                    <input type="text" id="num" placeholder="Type Number">
                </div>
                <div class="card">
                    <label for="add">Address</label>
                    <input type="text" id="add" placeholder="Type Address">
                </div>
            </div>
            <div>
                <label for="comments">Comments</label>
                <textarea id="comments" rows="7">Post Comments</textarea>
            </div>
            <div>
                <button type="submit">Send Message</button>
            </div>
        </form>
    </section>

    <section class="futter">
        <%- include("includes/footer.ejs") %>
    </section>



</body>
</html>