<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Services List</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="/style.css">
    <link rel="stylesheet" href="/navStyle.css">
    <link rel="stylesheet" href="/utility.css">
    <link rel="stylesheet" href="/serviceListStyle.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css">
    <script src="/update.js" defer type="module"></script>
    <style>
        .active {
            background-color: lightgreen;
        }

        .range-container{
            border: 1px solid #ddd;
            padding-top: 20px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            gap:5px;
        }

        .range-container label {
            display: block;
            margin-bottom: 10px;
            color: #5b5757;
        }

        input[type="range"] {
            width: 100%;
            height: 5px;
            border-radius: 5px;
            background: #ddd;
            outline: none;
            -webkit-appearance: none;
        }

        input[type="range"]::-webkit-slider-thumb {
            -webkit-appearance: none;
            width: 20px;
            height: 20px;
            background: #1DBF73;
            border-radius: 50%;
            cursor: pointer;
        }

        .range-labels {
            display: flex;
            justify-content: space-between;
            margin-top: 5px;
            color: #5b5757;
            font-size: 14px;
        }
        .submit{
            background-color: #1DBF73;
            width: 50%;
            height: 100%;
            border: none;
            border-radius: 10px;
            font-weight: 500;
        }
    </style>
</head>

<body>

    <%- include('includes/dialog.ejs') %>

        <%- include("includes/nav.ejs") %>

            <div class="aboutOuter flex align-center">
                <div class="aboutInner">
                    <div>Home | Service List</div>
                    <div>Our Best Services List</div>
                </div>
            </div>

            <div class="choosing">
                <div>
                    <select onchange="filterByCategory(this.value)">
                        <option value="all">Select a Category</option>
                        <option value="saloonSpa">Saloon & Spa</option>
                        <option value="cleaning">Cleaning</option>
                        <option value="electric">Electric</option>
                        <option value="homeMove">Home Move</option>
                        <option value="painting">Painting</option>
                    </select>
                </div>
                <div class="range-container">
                    <label style="color: black;" for="priceRange">Price Range: ₹<span id="rangeValue"
                            style="color: black;">0</span></label>

                    <input type="range" id="priceRange" min="0" max="5000" step="100" value="0"
                        oninput="updateRangeValue(this.value)">

                    <div class="range-labels">
                        <span style="color: black;">₹0</span>
                        <span style="color: black;">₹5000</span>
                    </div>

                    <!-- <select>
                        <option value="" disabled selected>Price Range</option>
                        <option value="Price Range">Price Range</option>
                        <option value="Price Range">Price Range</option>
                        <option value="Price Range">Price Range</option>
                        <option value="Price Range">Price Range</option>
                    </select> -->
                </div>
                <div>
                    <select>
                        <option value="" disabled selected>Ratings</option>
                        <option value="Ratings">Ratings</option>
                        <option value="Ratings">Ratings</option>
                        <option value="Ratings">Ratings</option>
                        <option value="Ratings">Ratings</option>
                    </select>
                </div>
                <div>
                    <!-- <label style="color: #5b5757;" for="Sorting">Sort By:</label>
                    <select id="Sorting">
                        <option value="" disabled selected>Sort by</option>
                        <option value="Category1">$0 to $20</option>
                        <option value="Category2">$20 to $40</option>
                        <option value="Category3">$40 to $60</option>
                        <option value="Category4">$60 to $80</option>
                    </select> -->
                    <button class="submit" type="submit">Search</button>
                </div>
            </div>

            <div class="resultCount">
                <div class="wrapper">
                    <div>
                        <%= totalServices %> Search Results
                    </div>
                    <div>Showing <%= serviceProviders.length %> of <%= totalServices %>
                    </div>
                </div>
            </div>

            <section class="featured">
                <div class="carousel">
                    <div class="wrapper">

                        <% for(let seller of serviceProviders) { %>
                            <div class="card">
                                <div class="image">
                                    <img src="<%= seller.photo %>" alt="">
                                </div>
                                <div class="profile">
                                    <div style="color: #666666;">
                                        <%= seller.name %>
                                    </div>
                                    <div style="color: #666666;">
                                        <img src="/svgs/star.svg"> 4.9(231)
                                    </div>
                                </div>
                                <div class="heading">
                                    <%= seller.serviceName %>
                                </div>
                                <div class="para" style="color: #666666;">
                                    It is a long established fact that a reader will be distracted by the readable
                                </div>
                                <div class="rate flex">
                                    <div style="color:#666666;">Starting at</div>
                                    <div class="rupee">Rs. <%= seller.price %>
                                    </div>
                                </div>
                                <button class="green">Book Appointment</button>
                            </div>
                            <% } %>
                    </div>
                </div>

                <!-- Add pagination controls -->
                <div class="circles container">
                    <% for(let i=1; i <=totalPages; i++) { %>
                        <button class="<%= currentPage === i ? 'active' : '' %>"
                            onclick="window.location.href='/qixer/services?page=<%= i %>'">
                        </button>
                        <% } %>
                </div>
            </section>



            <section class="futter">
                <%- include("includes/footer.ejs") %>
            </section>

            <script>
                // Update active button state

                let buttons = document.querySelectorAll('circles button');

                buttons.forEach(button => {
                    button.addEventListener('click', function () {
                        buttons.forEach(btn =>
                            btn.classList.remove('active'));
                        this.classList.add('active');
                    });
                });


                let category;
                let price;
                // filter by Category

                // Replace the existing filterByCategory function with:
                function filterByCategory(cat) {
                    category=cat;
                }


                // Display selected value after document loaded.
                document.addEventListener('DOMContentLoaded', () => {
                    const urlParams = new URLSearchParams(window.location.search);
                    const category = urlParams.get('category');
                    const price= urlParams.get('price');
                    if (category) {
                        document.querySelector('select').value = category;
                    }
                    if(price){
                        document.getElementById('rangeValue').textContent = price;
                        document.getElementById('priceRange').value = price;
                    }
                });


                // Update range value
                function updateRangeValue(value) {
                    document.getElementById('rangeValue').textContent = value;
                    price=value;
                    // window.location.href = `/qixer/services?price=${value}`;
                }

                document.querySelector(".submit").addEventListener("click",()=>{
                    category = document.querySelector('select').value;
                    price= document.getElementById('rangeValue').textContent;
                    window.location.href = `/qixer/services?category=${category}&price=${price}`;
                })

            </script>


</body>

</html>