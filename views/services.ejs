<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Services List</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="/style.css">
    <link rel="stylesheet" href="/navStyle.css">
    <link rel="stylesheet" href="/utility.css">
    <link rel="stylesheet" href="/serviceListStyle.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css">
    <script src="/update.js" defer type="module"></script>
    <style>
        .active{
            background-color: lightgreen;
        }
    </style>
</head>

<body>

    <%- include('includes/dialog.ejs') %>

        <%- include("includes/nav.ejs") %>

            <div class="aboutOuter flex align-center">
                <div class="aboutInner">
                    <div>Home | Service List</div>
                    <div>Our Best Services List</div>
                </div>
            </div>

            <div class="choosing">
                <div>
                    <select>
                        <option value="" disabled selected>Select a Category</option>
                        <option value="Category1">Category 1</option>
                        <option value="Category2">Category 2</option>
                        <option value="Category3">Category 3</option>
                        <option value="Category4">Category 4</option>
                    </select>
                </div>
                <div>
                    <select>
                        <option value="" disabled selected>Price Range</option>
                        <option value="Price Range">Price Range</option>
                        <option value="Price Range">Price Range</option>
                        <option value="Price Range">Price Range</option>
                        <option value="Price Range">Price Range</option>
                    </select>
                </div>
                <div>
                    <select>
                        <option value="" disabled selected>Ratings</option>
                        <option value="Ratings">Ratings</option>
                        <option value="Ratings">Ratings</option>
                        <option value="Ratings">Ratings</option>
                        <option value="Ratings">Ratings</option>
                    </select>
                </div>
                <div>
                    <label style="color: #5b5757;" for="Sorting">Sort By:</label>
                    <select id="Sorting">
                        <option value="" disabled selected>Sort by</option>
                        <option value="Category1">$0 to $20</option>
                        <option value="Category2">$20 to $40</option>
                        <option value="Category3">$40 to $60</option>
                        <option value="Category4">$60 to $80</option>
                    </select>
                </div>
            </div>

            <div class="resultCount">
                <div class="wrapper">
                    <div>
                        <%= totalServices %> Search Results
                    </div>
                    <div>Showing <%= serviceProviders.length %> of <%= totalServices %>
                    </div>
                </div>
            </div>

            <section class="featured">
                <div class="carousel">
                    <div class="wrapper">
                        <% for(let seller of serviceProviders) { %>
                            <div class="card">
                                <div class="image">
                                    <img src="<%= seller.photo %>" alt="">
                                </div>
                                <div class="profile">
                                    <div style="color: #666666;">
                                        <%= seller.name %>
                                    </div>
                                    <div style="color: #666666;">
                                        <img src="/svgs/star.svg"> 4.9(231)
                                    </div>
                                </div>
                                <div class="heading">
                                    <%= seller.serviceName %>
                                </div>
                                <div class="para" style="color: #666666;">
                                    It is a long established fact that a reader will be distracted by the readable
                                </div>
                                <div class="rate flex">
                                    <div style="color:#666666;">Starting at</div>
                                    <div class="rupee">Rs. <%= seller.price %>
                                    </div>
                                </div>
                                <button class="green">Book Appointment</button>
                            </div>
                            <% } %>
                    </div>
                </div>

                <!-- Add pagination controls -->
                <div class="circles container">
                    <% for(let i=1; i <=totalPages; i++) { %>
                        <button class="<%= currentPage === i ? 'active' : '' %>"
                            onclick="window.location.href='/qixer/services?page=<%= i %>'">
                        </button>
                    <% } %>
                </div>
            </section>



            <section class="futter">
                <%- include("includes/footer.ejs") %>
            </section>

            <script>
                // Update active button state

                let buttons= document.querySelectorAll('circles button');

                buttons.forEach(button => {
                    button.addEventListener('click', function () {
                        buttons.forEach(btn =>
                            btn.classList.remove('active'));
                        this.classList.add('active');
                    });
                });

            </script>


</body>

</html>