<% const limitedProviders=serviceProviders.slice(12) %>

    <% for( seller of limitedProviders ) { %>
        <div class="card">
            <div class="image">
                <!-- <img src="https://bytesed.com/tf/qixer/qixer_html/assets/img/service/fs1.jpg"> -->
                <img src="<%= seller.photo %>" alt="">
            </div>
            <div class="profile">
                <div style="color: #666666;">
                    <%= seller.name %>
                </div>
                <div style="color: #666666;">
                    <img src="/svgs/star.svg"> 4.9(231)
                </div>
            </div>
            <div class="heading">
                <%= seller.serviceName %>
            </div>
            <div class="para" style="color: #666666;">It is a long established fact that a reader
                will be
                distracted by the readable</div>
            <div class="rate flex">
                <div style="color:#666666;">Starting at</div>
                <div class="rupee">Rs. <%= seller.price %>
                </div>
            </div>
            <button class="green">Book Appointment</button>
        </div>
        <% } %>